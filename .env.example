# Required PostgreSQL connection. Do not commit real credentials.
DATABASE_URL=

# Required: unique random value of at least 32 characters.
JWT_SECRET=

# Comma-separated browser origins. Local static UI is same-origin by default.
CORS_ORIGINS=http://localhost:3002
HOST=127.0.0.1
PORT=3002

# Local demo login is opt-in and is forcibly disabled in production.
ENABLE_DEMO_LOGIN=false

# One-time local admin provisioning (never commit values):
# BOOTSTRAP_ACKNOWLEDGEMENT=create-initial-admin
# PROVISION_ADMIN_EMAIL=
# PROVISION_ADMIN_PASSWORD=
# PROVISION_ADMIN_NAME=

# Destructive demo fixtures require both values and must target a disposable DB:
# DESTRUCTIVE_DEMO_SEED_ACKNOWLEDGEMENT=replace-all-data-with-demo-fixtures
# DEMO_SEED_PASSWORD=
